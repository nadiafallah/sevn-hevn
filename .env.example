# Copy to .env.local for local development. Never commit real values.

# Public base URL used for canonical links, sharing metadata and WhatsApp item links.
# Leave empty locally to default to https://www.sevnhevn.ae
NEXT_PUBLIC_SITE_URL=

# Search indexing. Keep "false" until the public launch is approved.
# When "true" (and on the production deployment), robots.txt allows crawling and pages are indexable.
SITE_INDEXING=false

# Show clearly-labelled demo records to test the bag and checkout states locally.
# Ignored on production deployments.
DEMO_INVENTORY=false

# Optional: Facebook page URL. The link stays hidden while this is empty.
NEXT_PUBLIC_FACEBOOK_URL=

# Analytics events are forwarded only when "true" AND the visitor has consented (a consent banner is required first).
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── Supabase (catalogue + website enquiries). Dashboard → Project Settings → API Keys. ──
# Project URL, e.g. https://<project-ref>.supabase.co  (all environments)
SUPABASE_URL=
# Publishable key (sb_publishable_…). Read-only by row-level security: published products only. (all environments)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server-only. Set it in Vercel for PRODUCTION ONLY — the site refuses to
# write enquiries anywhere except the production deployment. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Shared secret Supabase sends to /api/revalidate when products change (production only).
# Must match the Vault entry "catalog_revalidate_secret". Generate with: openssl rand -hex 32
CATALOG_REVALIDATE_SECRET=

# Payments (server-only, not yet used). Add the chosen provider's keys here — never with a NEXT_PUBLIC_ prefix.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ── Concierge chat + private panel (/chat, /admin). See docs/CONCIERGE.md. ──
# Dedicated server key for the chat (random, 48+ characters). Its SHA-256 hash is stored in the
# database (private.server_keys); the key itself only in Vercel → Production, marked Sensitive.
# It can only call the chat's own database functions. Without it the chat says it is unavailable.
CONCIERGE_SERVER_KEY=
# Local test stack only (scripts/local-stack.mjs). Never set on Vercel.
# CONCIERGE_ALLOW_NON_PRODUCTION=true

# Team e-mail notifications through the info@sevnhevn.ae mailbox (Host Arabia cPanel SMTP).
SMTP_HOST=
# 465 (implicit TLS, recommended) or 587 (STARTTLS).
SMTP_PORT=465
SMTP_USER=
# Mailbox password — Vercel Production only, marked Sensitive. Never in this file or in chat.
SMTP_PASSWORD=
# Where new-request notifications go, and the sender shown.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# WhatsApp notifications (Meta WhatsApp Business Platform, Cloud API). All four are needed.
# The template must be an approved "utility" template with two body variables: {{1}} reference, {{2}} panel link.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The team member's own WhatsApp number that receives alerts (E.164, e.g. +9715XXXXXXXX).
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v26.0

# Optional AI assistance (off by default; costs money per use — see docs/CONCIERGE.md before enabling).
CONCIERGE_AI_ENABLED=false
# CONCIERGE_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CONCIERGE_AI_MODEL=claude-opus-5-5
# CONCIERGE_AI_PER_CONVERSATION=6
# CONCIERGE_AI_PER_DAY=300

# Daily retry of unsent notifications by Vercel Cron (random, Production only, Sensitive).
CRON_SECRET=
